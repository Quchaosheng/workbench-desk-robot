# Replace role placeholders with GitHub users or organization teams, then rename to CODEOWNERS.
#
# Role names describe what the owner is accountable for, so a new contributor can
# tell from the path alone who reviews a change.

/services/agent_runtime/   @REPLACE_RUNTIME_OWNER
/apps/dashboard/           @REPLACE_INTERACTION_OWNER
/services/perception/      @REPLACE_PERCEPTION_OWNER
/sim/scenarios/            @REPLACE_PERCEPTION_OWNER
/services/world_model/     @REPLACE_WORLD_MODEL_OWNER
/services/backend/         @REPLACE_WORLD_MODEL_OWNER
/robot/description/        @REPLACE_MOTION_OWNER
/robot/control/            @REPLACE_MOTION_OWNER
/robot/bringup/            @REPLACE_INTEGRATION_OWNER
/firmware/                 @REPLACE_MCU_OWNER
/.github/                  @REPLACE_INTEGRATION_OWNER
/.devcontainer/            @REPLACE_INTEGRATION_OWNER
/tools/                    @REPLACE_INTEGRATION_OWNER

# Contract changes need the producer, the world model and integration to agree,
# because another module is already written against the frozen schema.
/interfaces/               @REPLACE_RUNTIME_OWNER @REPLACE_WORLD_MODEL_OWNER @REPLACE_INTEGRATION_OWNER
/libs/contracts/           @REPLACE_RUNTIME_OWNER @REPLACE_WORLD_MODEL_OWNER
