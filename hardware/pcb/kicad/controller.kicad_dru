(version 1)

(rule "Primary-to-secondary isolation"
  (constraint clearance (min 8mm))
  (condition "((A.NetName =~ '^(VBAT_RAW|VBAT_FUSED|FET_COMMON|FET_GATE|INPUT_SENSE|VBAT_PROTECTED|GND_PWR|U1_GATE|U1_SHDN|UV_SET|OV_SET)$') && (B.NetName != '') && (B.NetName !~ '^(VBAT_RAW|VBAT_FUSED|FET_COMMON|FET_GATE|INPUT_SENSE|VBAT_PROTECTED|GND_PWR|U1_GATE|U1_SHDN|UV_SET|OV_SET)$')) || ((B.NetName =~ '^(VBAT_RAW|VBAT_FUSED|FET_COMMON|FET_GATE|INPUT_SENSE|VBAT_PROTECTED|GND_PWR|U1_GATE|U1_SHDN|UV_SET|OV_SET)$') && (A.NetName != '') && (A.NetName !~ '^(VBAT_RAW|VBAT_FUSED|FET_COMMON|FET_GATE|INPUT_SENSE|VBAT_PROTECTED|GND_PWR|U1_GATE|U1_SHDN|UV_SET|OV_SET)$'))")
)
