{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorldEvent",
  "description": "Append-only event. Replaying the same event stream in sequence_no order must reproduce an identical WorldState hash.",
  "type": "object",
  "required": ["event_id", "run_id", "sequence_no", "event_type", "occurred_at", "payload"],
  "properties": {
    "event_id": {"type": "string"},
    "run_id": {"type": "string"},
    "sequence_no": {"type": "integer", "minimum": 0},
    "event_type": {
      "enum": [
        "observation",
        "action_request",
        "action_result",
        "verification",
        "fault",
        "emotion",
        "task_accepted",
        "task_terminal"
      ]
    },
    "payload": {"type": "object"},
    "occurred_at": {"type": "string"},
    "recorded_at": {"type": "string"},
    "clock_id": {"enum": ["monotonic", "wall"]},
    "evidence_refs": {"type": "array", "items": {"type": "string"}}
  }
}
